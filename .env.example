# ============================================================
#  GeoSite AI — SMS Provider Credentials
#  Copy this file to .env and fill in your credentials.
#  The system will auto-detect which provider to use.
#  Leave all fields empty to use Demo Mode (OTP shown on screen).
# ============================================================

# ── OPTION 1: TWILIO (Recommended — Global coverage) ─────────
# Sign up free at https://www.twilio.com/try-twilio
# Free trial includes credits to send real SMS messages.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── OPTION 2: FAST2SMS (Best for India — Free credits) ───────
# Sign up free at https://www.fast2sms.com
# Get free credits on registration, no credit card needed.
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=GEOSIT

# ── OPTION 3: MSG91 (India — Alternative) ───────────────────
# Sign up at https://msg91.com
MSG91_AUTH_KEY=your_msg91_authkey_here
MSG91_TEMPLATE_ID=your_otp_template_id_here
MSG91_SENDER_ID=GEOSIT
